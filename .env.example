# .env.example — copy to .env and fill in your own keys.
#
#   cp .env.example .env      # macOS / Linux
#   Copy-Item .env.example .env   # Windows PowerShell
#
# .env is gitignored — real keys must NEVER be committed to this public repo.
# Most review CLIs authenticate via their own `login` command (see AGENTS.md);
# put an API key here only for providers you wire up via environment variables.

# ── GLM 5.2 / Kilo (z.ai) ─────────────────────────────────────────────
# GLM 5.2 is used by the kilo-review gate (model z-ai/glm-5.2).
# Preferred path is `kilo auth login`; if you instead drive GLM via an API
# key, put it here and export it before running the gate.
ZAI_API_KEY=
# GLM_API_KEY=            # alias some tools expect — set if yours needs it

# ── Other review providers (only if you use env-key auth) ─────────────
# Codex: normally `codex login` (ChatGPT subscription, no key needed).
# OPENAI_API_KEY=
# Kimi: normally `kimi login`.
# MOONSHOT_API_KEY=
# MiMo:
# MIMO_API_KEY=

# ── Gate tuning (optional; read directly by the gate scripts) ─────────
# Turn any gate off entirely: set to "off".
# CODEX_REVIEW_GATE=
# KIMI_REVIEW_GATE=
# KILO_REVIEW_GATE=
# MIMO_REVIEW_GATE=
# Kilo/GLM model + variant overrides (defaults: z-ai/glm-5.2, max):
# KILO_REVIEW_MODEL=z-ai/glm-5.2
# KILO_REVIEW_VARIANT=max
# KILO_REVIEW_TIMEOUT_MS=600000
# MIMO_REVIEW_MODEL=mimo/mimo-v2.5-pro
